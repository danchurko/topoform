{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Topoform diagram model v1",
  "description": "Structural schema only. Run scripts/diagram.py validate for cross-record invariants, source links, asset integrity, and supported Topoform semantics.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1,
      "type": "integer"
    },
    "title": {
      "type": "string",
      "maxLength": 200,
      "minLength": 1
    },
    "description": {
      "type": "string",
      "maxLength": 20000
    },
    "metadata": {
      "type": "object"
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      },
      "maxItems": 1000
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      },
      "maxItems": 4000
    },
    "views": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/view"
      }
    },
    "layout": {
      "type": "object",
      "properties": {
        "direction": {
          "enum": [
            "RIGHT",
            "DOWN",
            "LEFT",
            "UP"
          ]
        },
        "spacing": {
          "type": "number",
          "minimum": 30,
          "maximum": 1000
        },
        "layerSpacing": {
          "type": "number",
          "minimum": 60,
          "maximum": 1000
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "title",
    "nodes",
    "edges"
  ],
  "additionalProperties": false,
  "$defs": {
    "node": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,95}$",
          "not": {
            "enum": [
              "__defineGetter__",
              "__defineSetter__",
              "__lookupGetter__",
              "__lookupSetter__",
              "__proto__",
              "constructor",
              "hasOwnProperty",
              "isPrototypeOf",
              "propertyIsEnumerable",
              "prototype",
              "root",
              "toLocaleString",
              "toString",
              "valueOf"
            ]
          }
        },
        "label": {
          "type": "string",
          "maxLength": 500,
          "minLength": 1
        },
        "parent": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,95}$",
          "not": {
            "enum": [
              "__defineGetter__",
              "__defineSetter__",
              "__lookupGetter__",
              "__lookupSetter__",
              "__proto__",
              "constructor",
              "hasOwnProperty",
              "isPrototypeOf",
              "propertyIsEnumerable",
              "prototype",
              "root",
              "toLocaleString",
              "toString",
              "valueOf"
            ]
          }
        },
        "icon": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "maxLength": 20000
        },
        "kind": {
          "type": "string",
          "maxLength": 20000,
          "minLength": 1
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "metadata": {
          "type": "object"
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "maxLength": 20000,
                "minLength": 1
              },
              "url": {
                "type": "string",
                "pattern": "^https?://"
              }
            },
            "required": [
              "label",
              "url"
            ],
            "additionalProperties": false
          }
        },
        "evidence": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "observed",
                "declared",
                "inferred",
                "proposed"
              ]
            },
            "source": {
              "type": "string",
              "maxLength": 20000,
              "minLength": 1
            }
          },
          "required": [
            "status"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "observed"
                  }
                }
              },
              "then": {
                "required": [
                  "source"
                ]
              }
            }
          ]
        }
      },
      "required": [
        "id",
        "label"
      ],
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,95}$",
          "not": {
            "enum": [
              "__defineGetter__",
              "__defineSetter__",
              "__lookupGetter__",
              "__lookupSetter__",
              "__proto__",
              "constructor",
              "hasOwnProperty",
              "isPrototypeOf",
              "propertyIsEnumerable",
              "prototype",
              "root",
              "toLocaleString",
              "toString",
              "valueOf"
            ]
          }
        },
        "source": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,95}$",
          "not": {
            "enum": [
              "__defineGetter__",
              "__defineSetter__",
              "__lookupGetter__",
              "__lookupSetter__",
              "__proto__",
              "constructor",
              "hasOwnProperty",
              "isPrototypeOf",
              "propertyIsEnumerable",
              "prototype",
              "root",
              "toLocaleString",
              "toString",
              "valueOf"
            ]
          }
        },
        "target": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,95}$",
          "not": {
            "enum": [
              "__defineGetter__",
              "__defineSetter__",
              "__lookupGetter__",
              "__lookupSetter__",
              "__proto__",
              "constructor",
              "hasOwnProperty",
              "isPrototypeOf",
              "propertyIsEnumerable",
              "prototype",
              "root",
              "toLocaleString",
              "toString",
              "valueOf"
            ]
          }
        },
        "label": {
          "type": "string",
          "maxLength": 20000
        },
        "directed": {
          "type": "boolean"
        },
        "description": {
          "type": "string",
          "maxLength": 20000
        },
        "kind": {
          "type": "string",
          "maxLength": 20000,
          "minLength": 1
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "metadata": {
          "type": "object"
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "maxLength": 20000,
                "minLength": 1
              },
              "url": {
                "type": "string",
                "pattern": "^https?://"
              }
            },
            "required": [
              "label",
              "url"
            ],
            "additionalProperties": false
          }
        },
        "evidence": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "observed",
                "declared",
                "inferred",
                "proposed"
              ]
            },
            "source": {
              "type": "string",
              "maxLength": 20000,
              "minLength": 1
            }
          },
          "required": [
            "status"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "status": {
                    "const": "observed"
                  }
                }
              },
              "then": {
                "required": [
                  "source"
                ]
              }
            }
          ]
        }
      },
      "required": [
        "id",
        "source",
        "target"
      ],
      "additionalProperties": false
    },
    "view": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,95}$",
          "not": {
            "enum": [
              "__defineGetter__",
              "__defineSetter__",
              "__lookupGetter__",
              "__lookupSetter__",
              "__proto__",
              "constructor",
              "hasOwnProperty",
              "isPrototypeOf",
              "propertyIsEnumerable",
              "prototype",
              "root",
              "toLocaleString",
              "toString",
              "valueOf"
            ]
          }
        },
        "label": {
          "type": "string",
          "maxLength": 20000,
          "minLength": 1
        },
        "nodeIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,95}$",
            "not": {
              "enum": [
                "__defineGetter__",
                "__defineSetter__",
                "__lookupGetter__",
                "__lookupSetter__",
                "__proto__",
                "constructor",
                "hasOwnProperty",
                "isPrototypeOf",
                "propertyIsEnumerable",
                "prototype",
                "root",
                "toLocaleString",
                "toString",
                "valueOf"
              ]
            }
          },
          "uniqueItems": true
        },
        "edgeKinds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "label",
        "nodeIds"
      ],
      "additionalProperties": false
    }
  }
}
